# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Lo que no es el producto ──
# Entregas, demos, capturas y zips: material de trabajo nuestro,
# no código de HUBI. Fuera del repositorio.
#
# Este bloque VIVE AQUÍ, en el repositorio, y no solo en la máquina de
# Haris. Estuvo solo en la suya y duró un día: cada zip que se le
# entrega trae este fichero dentro y se lo sobrescribía, así que las
# exclusiones se deshacían solas y los zips volvían a colarse en el
# siguiente commit.
*.patch
*.zip
/*.html
/*.mp4
/*.bat
/web/
/Claude outputs/
comprobar.mjs
