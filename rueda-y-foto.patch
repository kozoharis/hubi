+/*
+  ═══════════════════════════════════════════════════════════════
+  LA RUEDA DE AJUSTES, CON LOS COLORES DE HUBI
+  ═══════════════════════════════════════════════════════════════
+
+  Suelta, sin caja. Una píldora con borde y fondo la convertía en «un
+  botón más» al lado del logo, y en esa esquina no compite con nada:
+  es lo único que hay.
+
+  ─────────────────────────────────────────────────────────────
+  EL COLOR SALE DE LA PROPIA H
+
+  Turquesa, naranja y rojo son los píxeles del logo, medidos — no tres
+  colores bonitos elegidos aparte. Por eso la rueda se lee como parte
+  de HUBI y no como un icono pegado encima.
+
+  ─────────────────────────────────────────────────────────────
+  SE VE PEQUEÑA Y SE TOCA GRANDE
+
+  El dibujo mide 30 px; lo que responde al dedo, 48. Es la regla de
+  siempre —nada por debajo de 48 para lo que hay que pulsar— y aquí
+  hace más falta que nunca: sin caja no hay borde que diga dónde
+  acaba, así que el hueco tiene que perdonar la puntería.
+
+  ─────────────────────────────────────────────────────────────
+  Y EL DEGRADADO LLEVA UN IDENTIFICADOR FIJO, A PROPÓSITO
+
+  Normalmente eso sería un fallo esperando a pasar: dos SVG con el
+  mismo identificador y el segundo se pinta con el degradado del
+  primero. Aquí da igual —los dos degradados son idénticos— y evita
+  tener que convertir este archivo en componente de navegador solo
+  para generar un número. Este archivo lo usan pantallas de servidor;
+  un `useId` aquí las rompería todas.
+*/
+export function Rueda({ tam = 30 }: { tam?: number }) {
+  return (
+    <svg
+      width={tam}
+      height={tam}
+      viewBox="0 0 24 24"
+      fill="none"
+      aria-hidden
+      style={{ display: 'block' }}
+    >
+      <defs>
+        <linearGradient
+          id="hubi-rueda"
+          x1="2.5"
+          y1="2.5"
+          x2="21.5"
+          y2="21.5"
+          gradientUnits="userSpaceOnUse"
+        >
+          <stop offset="0%" stopColor="#02C1C0" />
+          <stop offset="48%" stopColor="#FF7D20" />
+          <stop offset="100%" stopColor="#FD4F4F" />
+        </linearGradient>
+      </defs>
+      <path
+        d={TRAZOS.rueda}
+        stroke="url(#hubi-rueda)"
+        strokeWidth={1.9}
+        strokeLinecap="round"
+        strokeLinejoin="round"
+      />
+    </svg>
+  )
+}
