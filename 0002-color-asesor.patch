+     y con cuentas. Sin esto, un identificador escrito a mano borraría
+     la carpeta Salud desde esta misma ruta. */
+  const { data: suya } = await supabase
+    .from('categorias')
+    .select('id, nombre, padre_id, lleva_cuentas')
+    .eq('id', id)
+    .is('padre_id', null)
